{
  "name": "simkind",
  "version": "0.2.0-alpha.1",
  "private": false,
  "description": "TypeScript toolkit for LLM-driven simulated characters: memory, commitments, asynchronous decisions, and deterministic replay.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "import": "./dist/runner/index.js"
    },
    "./node": {
      "types": "./dist/runner/node.d.ts",
      "import": "./dist/runner/node.js"
    },
    "./schemas/0.2.0-draft.2/*": "./schemas/0.2.0-draft.2/*",
    "./schemas/0.2.0-draft.1/character.schema.json": {
      "default": "./schemas/0.2.0-draft.1/character.schema.json"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./spatial": {
      "types": "./dist/spatial/index.d.ts",
      "import": "./dist/spatial/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "README.md",
    "NOTICE.md",
    "CONTRIBUTING.md",
    "docs/README.md",
    "docs/documentation-policy.md",
    "docs/architecture.md",
    "docs/integration.md",
    "docs/character-format.md",
    "docs/portable-scenarios.md",
    "docs/goals-and-memory.md",
    "docs/determinism-and-evaluation.md",
    "docs/testing.md",
    "docs/continuity.md",
    "docs/checkpoints.md",
    "docs/interventions.md",
    "docs/playground.md",
    "docs/providers-and-spatial.md",
    "docs/interoperability.md",
    "docs/release-alpha.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run check:generated && npm run build && npm run typecheck && npm test",
    "generate:format": "node scripts/generate-format.mjs",
    "check:generated": "node scripts/generate-format.mjs --check",
    "format:check": "npm run build --silent && node scripts/check-character.mjs",
    "scenario": "npm run build --silent && tsx examples/portable/cli.ts",
    "prepare": "npm run build",
    "test": "vitest run",
    "demo": "tsx examples/two-simkins-demo.ts",
    "demo:openrouter": "tsx examples/openrouter-demo.ts",
    "demo:openrouter:soak": "tsx examples/openrouter-village-demo.ts",
    "demo:soak": "tsx examples/village-soak-demo.ts",
    "demo:settlement": "npm run build --silent && tsx demos/settlement-crisis/cli.ts",
    "example": "tsx examples/reference-world.ts",
    "example:station": "tsx examples/station-world.ts",
    "check:public": "node scripts/check-public-files.mjs",
    "setup": "npm ci && node scripts/setup.mjs",
    "playground": "npm run build --silent && tsx playground/cli.ts",
    "scenario:resume": "npm run build --silent && tsx examples/portable/resume.ts",
    "scenario:smoke": "npm run build --silent && tsx examples/portable/live-smoke.ts",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:runs": "npm run build --silent && tsx scripts/generate-run-fixtures.ts --check",
    "generate:runs": "npm run build --silent && tsx scripts/generate-run-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.2",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickmibarra/simkind.git"
  },
  "bugs": {
    "url": "https://github.com/nickmibarra/simkind/issues"
  },
  "homepage": "https://github.com/nickmibarra/simkind#readme",
  "dependencies": {
    "ajv": "^8.20.0",
    "jsonc-parser": "^3.3.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
