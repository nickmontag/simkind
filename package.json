{
  "name": "simkind",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript toolkit for LLM-driven simulated characters: memory, commitments, asynchronous decisions, and deterministic replay.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "NOTICE.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run build && npm run typecheck && npm test",
    "prepare": "npm run build",
    "test": "vitest run",
    "demo": "tsx examples/two-simkins-demo.ts",
    "demo:openrouter": "tsx examples/openrouter-demo.ts",
    "demo:openrouter:soak": "tsx examples/openrouter-village-demo.ts",
    "demo:soak": "tsx examples/village-soak-demo.ts",
    "demo:settlement": "npm run build --silent && tsx demos/settlement-crisis/cli.ts",
    "example": "tsx examples/reference-world.ts",
    "example:station": "tsx examples/station-world.ts",
    "check:public": "node scripts/check-public-files.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickmibarra/simkind.git"
  },
  "bugs": {
    "url": "https://github.com/nickmibarra/simkind/issues"
  },
  "homepage": "https://github.com/nickmibarra/simkind#readme"
}
